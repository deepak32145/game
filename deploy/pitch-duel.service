[Unit]
Description=Pitch Duel game server
After=network-online.target
Wants=network-online.target

[Service]
User=pitchduel
WorkingDirectory=/opt/pitch-duel/server
EnvironmentFile=/opt/pitch-duel/server/.env
ExecStart=/usr/bin/node src/index.js
Restart=always
RestartSec=3
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
