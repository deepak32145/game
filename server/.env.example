PORT=4000
MONGO_URI=mongodb://127.0.0.1:27017/pitch_duel
# Any long random string. Used to sign session tokens.
JWT_SECRET=change-me
# OAuth 2.0 Web client ID from https://console.cloud.google.com/apis/credentials
# Leave empty to hide the Google button.
GOOGLE_CLIENT_ID=
# Guest login (pick a name, no password). Set to false to require Google sign-in.
ALLOW_DEV_LOGIN=true
