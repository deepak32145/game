PORT=4000
MONGO_URI=mongodb://127.0.0.1:27017/pitch_duel
# Any long random string. Used to sign session tokens and login codes.
JWT_SECRET=change-me

# ---- Email login (a one-time code sent by email) ----
# The SMTP account that sends the codes. Use ONE of these two styles:
#   a) a well-known service:   SMTP_SERVICE=gmail
#   b) any provider's server:  SMTP_HOST=smtp.example.com  and  SMTP_PORT=587
# SMTP_USER is the account's user id, SMTP_PASS its key or app password.
# Leave all of these empty on your own computer: the code is then printed in the server log.
SMTP_SERVICE=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# The "From" line on the email. Defaults to: Pitch Duel <SMTP_USER>
MAIL_FROM=

# ---- Admins ----
# Email addresses (comma separated) allowed to open the admin page: add or deduct balance, ban players.
# Kept here, not in the code, so it is never published with the repository.
ADMIN_EMAILS=

# ---- Other ways to log in ----
# OAuth 2.0 Web client ID from https://console.cloud.google.com/apis/credentials
# Leave empty to hide the Google button.
GOOGLE_CLIENT_ID=
# Guest login (pick a name, no password, no email). For local testing only: guests have no
# proof of identity, so never switch this on where wallets matter.
ALLOW_DEV_LOGIN=false
